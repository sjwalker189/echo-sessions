package pages

import (
	"app/view/layout"
	"app/view/section"
	"fmt"
	"strings"
)

type Home struct {
	DocTitle string
	Title    string
	Content  string
	Config   section.ConfigModel
	Company  section.Company
}

templ (m Home) Render() {
	@layout.Default(m.DocTitle) {
		<section class="bg-blue-950 relative min-h-[60vh] flex pt-24 pb-6">
			<div style="background-image: url('/static/img/hero.webp')" class="absolute inset-0 bg-bottom bg-cover"></div>
			<div class="bg-linear-to-b from-black to-transparent absolute inset-0 z-10"></div>
			<div class="bg-linear-to-br from-[#040A3E] to-[#0D1B96] absolute inset-0 z-10 opacity-60"></div>
			<div class="max-w-xl mx-auto text-center text-white p-4 relative z-20 self-center">
				<h1 class="text-3xl md:text-4xl lg:text-6xl font-bold mb-6 leading-tight">
					{ m.Title }
				</h1>
				<div class="text-base md:text-lg font-medium text-blue-100 leading-loose mb-12">
					{ m.Content }
				</div>
				<div class="flex flex-col gap-4 md:block md:space-x-4">
					<a
						href={ fmt.Sprintf("tel:%s", strings.ReplaceAll(m.Config.PhoneNumber, " ", "")) }
						class="inline-block font-semibold rounded-full px-5 py-3 text-white bg-transparent border border-white"
					>
						Call Now
					</a>
					<a
						href="/quote"
						class="inline-block font-semibold rounded-full px-5 py-3 text-white bg-blue-600 border border-blue-600"
					>
						Request a Quote
					</a>
				</div>
			</div>
		</section>
		@section.WhyChooseUs()
		@section.GetInTouch()
		@section.Footer(m.Company)
	}
}
