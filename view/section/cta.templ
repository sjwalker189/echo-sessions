package section

type ConfigModel struct {
	Company     string
	PhoneNumber string
}

templ WhyChooseUs() {
	<section class="section section-gray">
		<div class="wrapper wrapper-prose px-3 lg:px-0 text-center self-center space-y-4">
			<h2 class="heading heading-lg">Why choose Rodney Joinery Services?</h2>
			<p class="leading-relaxed">
				We take pride in our work and are committed to providing high quality services that meet your specific
				needs. Mark brings a wealth of knowledge of all things aluminium joinery with his expertise encompassing
				installation, maintenance, and quality assurance.
			</p>
			<p class="leading-relaxed">
				Whether your needs are residential or commercial, Mark's expertise and connections with local fabricators,
				suppliers, and installers ensure we can meet them.
			</p>
		</div>
	</section>
}

templ GetInTouch() {
	<section class="flex section section-electric-blue">
		<div class="wrapper text-center lg:text-left self-center">
			<div class="lg:grid grid-cols-12 items-center gap-8">
				<div class="col-span-7">
					<h2 class="heading heading-lg">Get in touch</h2>
					<p class="leading-relaxed pt-4">
						Contact us today if you have any questions or want a free, no-obligation quote.
					</p>
				</div>
				<div class="col-span-5 flex flex-col gap-4 md:block md:space-x-3 pt-12">
					<a href="/quote" class="font-semibold rounded-full px-5 py-3 text-blue-950 bg-white border border-white">
						Request a Quote
					</a>
					<a
						href="tel:{{ $company->phone_number }}"
						class="font-semibold rounded-full px-5 py-3 text-white bg-transparent border border-white"
					>
						Call
						Us
					</a>
				</div>
			</div>
		</div>
	</section>
}
